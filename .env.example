# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# Variables marked REQUIRED are needed for the app to work; everything else is optional.
# Anything starting with NEXT_PUBLIC_ is sent to the browser: it must never be a secret.

# ---------------------------------------------------------------------------
# AI (REQUIRED for AI responses)
# ---------------------------------------------------------------------------
# NVIDIA API key used by /api/analyze and /api/demo (server only).
NVIDIA_API_KEY=
# Optional second model, tried once if the main model keeps failing (same NVIDIA endpoint).
# ANALYZE_FALLBACK_MODEL=

# ---------------------------------------------------------------------------
# Supabase (REQUIRED)
# ---------------------------------------------------------------------------
# Project URL and public (anon) key. Safe to expose to the browser; row-level security protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: full database access. SERVER ONLY. Never expose it, never prefix it NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: server-side URL override (defaults to NEXT_PUBLIC_SUPABASE_URL).
# SUPABASE_URL=

# ---------------------------------------------------------------------------
# Sign-in gate and local development
# ---------------------------------------------------------------------------
# true  = /app works without signing in (demo/local development, shared demo identity).
# false = /app requires a signed-in account. Use false in production.
ECHO_DEMO_MODE=false
# Optional fixed user id for local development when not signed in.
# ECHO_DEV_USER_ID=

# ---------------------------------------------------------------------------
# Admin panel (/admin): read-only counts and metadata
# ---------------------------------------------------------------------------
# Comma-separated. Only these accounts can open /admin; everyone else gets a 404.
# An email counts only once it is confirmed.
# ADMIN_EMAILS=you@example.com
# ADMIN_USER_IDS=

# ---------------------------------------------------------------------------
# AI rate limits and usage log
# ---------------------------------------------------------------------------
# AI_RATE_LIMIT_USER_MAX=30          # requests per window for signed-in users
# AI_RATE_LIMIT_ANON_MAX=10          # requests per window for anonymous visitors
# AI_RATE_LIMIT_WINDOW_MINUTES=60
# AI_RATE_LIMIT_DISABLED=false       # true turns limits off (usage is still logged)
# Secret salt for hashing visitor IPs in the usage log and public-link rate limiter. Use a long random string.
# USAGE_HASH_SALT=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# LOG_LEVEL=info                     # debug | info | warn | error
# Enables GET /api/health/ai (send "Authorization: Bearer <token>"). 16+ characters; leave unset to disable.
# HEALTH_CHECK_TOKEN=

# ---------------------------------------------------------------------------
# Video/voice calls behind strict firewalls (TURN relay). See docs/ai/TURN_SETUP.md.
# Set ONE of the two options. With neither, calls use public STUN only.
# ---------------------------------------------------------------------------
# Option A: Cloudflare Realtime TURN (short-lived credentials generated per request)
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# Option B: any provider with fixed credentials (Metered, Twilio, your own coturn)
# TURN_URLS=turn:HOST:80,turn:HOST:443,turns:HOST:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical public URL for SEO, sitemap and share links.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
